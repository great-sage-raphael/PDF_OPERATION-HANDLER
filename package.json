{
  "name": "pdf-toolkit",
  "version": "1.0.0",
  "description": "PDF Toolkit - Cyber Minimalist Mac App",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"vite --port 5173 --strictPort\" \"wait-on http://localhost:5173 && NODE_ENV=development electron .\"",
    "build": "vite build && electron-builder --mac",
    "build:dir": "vite build && electron-builder --mac --dir",
    "build:win": "vite build && electron-builder --win",
    "build:all": "vite build && electron-builder -mw",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tesseract.js": "^5.0.4"
  },
  "build": {
    "appId": "com.vinayak.pdftoolkit",
    "productName": "PDF Toolkit",
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "node_modules/**/*",
      "!node_modules/.cache/**/*"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "dmg": {
      "title": "PDF Toolkit",
      "iconSize": 80
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
